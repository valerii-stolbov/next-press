{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*", "!.env.example", "!.env.*.example"]
    },
    "check-types": {
      "dependsOn": []
    },
    "lint": {
      "dependsOn": []
    },
    "clean": {
      "cache": false
    }
  }
}
